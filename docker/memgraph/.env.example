# Memgraph test container. Read by the compose scripts (--env-file) and by
# MemgraphConfig.from_docker_env().

# Container settings
SPEC=graflo
CONTAINER_NAME="${SPEC}.memgraph"
IMAGE_VERSION=memgraph/memgraph-mage:3.14.0

# Connection settings
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687

# Authentication (optional)
# MEMGRAPH_USER=
# MEMGRAPH_PASSWORD=

# Default database name for tests
MEMGRAPH_DATABASE=memgraph
