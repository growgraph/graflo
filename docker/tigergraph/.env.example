# TigerGraph test container. Read by the compose scripts (--env-file) and by
# TigergraphConfig.from_docker_env(). The community image is not on Docker
# Hub as a stable release; load it from the vendor's tarball (see README).
IMAGE_VERSION=tigergraph/community:4.2.2
SPEC=graflo
CONTAINER_NAME="${SPEC}.tigergraph"
TG_SSH=14022
TG_REST=9001
TG_WEB=14241
