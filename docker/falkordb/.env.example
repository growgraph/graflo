# FalkorDB test container. Read by the compose scripts (--env-file) and by
# FalkordbConfig.from_docker_env().

# Container settings
SPEC=graflo
CONTAINER_NAME="${SPEC}.falkordb"
IMAGE_VERSION=falkordb/falkordb:6.0.4

# Connection settings
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Browser UI
FALKORDB_BROWSER_PORT=3001

# Authentication (optional - FalkorDB supports Redis AUTH)
# FALKORDB_PASSWORD=

# Default graph name for tests
FALKORDB_DATABASE=testgraph
