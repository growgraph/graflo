# SeaweedFS (S3) for file sources with an s3:// root. Read by the compose
# scripts (--env-file) and by S3EndpointConfig.from_docker_env(); every value
# below is also the default.

# Compose: profile is ${SPEC}.seaweedfs
SPEC=graflo
IMAGE_VERSION=chrislusf/seaweedfs:4.52
CONTAINER_NAME=graflo.seaweedfs
S3_API_PORT=8333

# Client: either S3_ENDPOINT, or the three parts.
# S3_ENDPOINT=http://127.0.0.1:8333
S3_PROTOCOL=http
S3_HOSTNAME=127.0.0.1

# The server has no identities configured and accepts any key pair; these
# only need to match what your S3 client sends.
S3_ACCESS_KEY=graflo
S3_SECRET_KEY=graflo-secret
S3_BUCKET=graflo-staging
AWS_REGION=us-east-1
