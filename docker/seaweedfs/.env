# SeaweedFS (S3) for local bulk staging. Copy to .env and adjust; every value
# below is the default, so the service also runs without a .env.

# Compose: profile is ${SPEC}.seaweedfs (start-all.sh reads SPEC from here)
SPEC=graflo
IMAGE_VERSION=chrislusf/seaweedfs:4.48
CONTAINER_NAME=graflo.seaweedfs
S3_API_PORT=8333

# Client (MinioConfig.from_docker_env). Either S3_ENDPOINT, or the three parts.
# S3_ENDPOINT=http://127.0.0.1:8333
S3_PROTOCOL=http
S3_HOSTNAME=127.0.0.1

# The server has no identities configured and accepts any key pair; these
# only need to match what your S3 client sends.
S3_ACCESS_KEY=graflo
S3_SECRET_KEY=graflo-secret
S3_BUCKET=graflo-staging
AWS_REGION=us-east-1

# The S3 URL as seen from a TigerGraph container, for GSQL bulk loads only.
# S3_LOADER_ENDPOINT=http://172.17.0.1:8333
