# Apache Kafka Docker configuration (KRaft combined mode)
# Image: https://hub.docker.com/r/apache/kafka

# Docker Compose
IMAGE_VERSION=apache/kafka:4.3.1
SPEC=graflo
CONTAINER_NAME="${SPEC}.kafka"

# Host bootstrap (clients on the host machine)
KAFKA_HOSTNAME=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Broker (single-node KRaft for local testing)
KAFKA_NODE_ID=1
KAFKA_NUM_PARTITIONS=1
