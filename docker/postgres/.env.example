# PostgreSQL test container. Read by the compose scripts (--env-file) and by
# PostgresConfig.from_docker_env().

# Docker Compose settings
IMAGE_VERSION=postgres:18.6
SPEC=graflo
CONTAINER_NAME="${SPEC}.postgres"

# Connection: POSTGRES_URI, or the three parts below
# POSTGRES_URI=postgresql://localhost:5432/postgres
POSTGRES_HOSTNAME=localhost
POSTGRES_PORT=5432
POSTGRES_PROTOCOL=postgresql

# Authentication; the image's own variables, used by the container and the config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
