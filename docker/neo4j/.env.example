# Neo4j test container. Read by the compose scripts (--env-file) and by
# Neo4jConfig.from_docker_env().
IMAGE_VERSION=neo4j:2026.10.1-community
SPEC=graflo
CONTAINER_NAME="${SPEC}.neo4j"
NEO4J_PORT=7475
NEO4J_BOLT_PORT=7688
NEO4J_AUTH="neo4j/test!passfortesting"

# Memory: the bulk writer builds indexes after loading, so the page cache matters.
NEO4J_HEAP_SIZE=4G
NEO4J_PAGECACHE_SIZE=8G
