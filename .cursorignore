*

!graflo/
!graflo/**
!docs/
!docs/**
!test/
!test/**
!examples/
!examples/**
!docker/
!docker/**
!sh/
!sh/**
!.github/
!.github/**
!.cursor/
!.cursor/**
!.claude/
!.claude/**
!.vscode/
!.vscode/**
!.env.example
!pyproject.toml
!mkdocs.yml
!.pre-commit-config.yaml
!.python-version
!*.md
!*.sh

**/.git/
**/.env
**/.env.*
**/*.env
!**/.env.example
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
